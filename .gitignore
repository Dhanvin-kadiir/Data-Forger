# ===============================================
#  DATA-FORGER // GHOST SYSTEM -- .gitignore
# ===============================================

# -- Sensitive runtime vault files (NEVER commit) --
titan_identities.txt
titan_keys.txt
*.txt

# -- Java compiled artifacts --
*.class
*.jar

# -- Maven build output (not used, kept for safety) --
target/

# -- Log files --
*.log

# -- IDE -- VS Code --
.vscode/

# -- IDE -- IntelliJ IDEA --
.idea/
*.iml

# -- IDE -- Eclipse --
.classpath
.project
.settings/
bin/

# -- OS generated files --
.DS_Store
Thumbs.db
desktop.ini

# -- Raw UI design stitch exports (not production code) --
UI/
