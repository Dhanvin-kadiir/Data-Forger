# ═══════════════════════════════════════════════
#  DATA-FORGER // GHOST SYSTEM — .gitignore
# ═══════════════════════════════════════════════

# ── Sensitive runtime data files (NEVER commit) ──
titan_identities.txt
titan_keys.txt
*.txt

# ── Java compiled artifacts ──
*.class
*.jar

# ── Maven build output ──
target/
!.mvn/wrapper/maven-wrapper.jar

# ── Log files ──
*.log
logs/

# ── IDE — VS Code ──
.vscode/

# ── IDE — IntelliJ IDEA ──
.idea/
*.iml
*.iws
*.ipr

# ── IDE — Eclipse ──
.classpath
.project
.settings/
bin/

# ── OS generated files ──
.DS_Store
Thumbs.db
desktop.ini

# ── UI stitch design reference files (raw design exports, not production code) ──
UI/
